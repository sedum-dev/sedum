#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

expected="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
actual="$(corepack pnpm --version)"
if [[ "$actual" != "$expected" ]]; then
  printf 'Expected pnpm %s, found %s. Run .agents/setup.\n' "$expected" "$actual" >&2
  exit 1
fi

export PATH="$HOME/.local/bin:$PATH"
if ! command -v swamp >/dev/null 2>&1; then
  printf 'Swamp CLI is missing. Run .agents/setup.\n' >&2
  exit 1
fi

for path in node_modules/.bin/vitest packages/core/dist/page-script/index.global.js; do
  if [[ ! -e "$path" ]]; then
    printf 'Orb workspace is missing %s. Run .agents/setup.\n' "$path" >&2
    exit 1
  fi
done

printf 'Orb workspace ready with pnpm %s and Swamp CLI.\n' "$actual"
