{
  "name": "@sedum-dev/reporters",
  "version": "0.1.0-alpha.2",
  "repository": "https://github.com/sedum-dev/sedum",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sedum-dev/core": "workspace:*"
  }
}
