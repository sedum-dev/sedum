{
  "name": "@sedum-dev/provider-typesafe",
  "version": "0.1.0-alpha.0",
  "repository": "https://github.com/sedum-dev/sedum",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sedum-dev/core": "workspace:*",
    "@typesafe-ai/sdk": "0.6.0",
    "p-queue": "9.3.3"
  }
}
