{
  "name": "@sedum-dev/core",
  "version": "0.1.0-alpha.13",
  "repository": "https://github.com/sedum-dev/sedum",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script-api.d.ts",
      "import": "./dist/script-api.js"
    },
    "./page-script.js": "./dist/page-script/index.global.js",
    "./run-result.schema.json": "./dist/run-result.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/script-api.ts --format esm --dts --clean --out-dir dist && node scripts/write-run-result-schema.mjs && tsup src/page-script/index.ts --format iife --platform browser --global-name SedumPageScript --out-dir dist/page-script",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "jiti": "2.7.0",
    "p-queue": "9.3.3",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hegeldev/hegel": "0.4.7"
  }
}
