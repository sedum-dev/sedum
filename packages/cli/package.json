{
  "name": "sedum-cli",
  "version": "0.1.0-alpha.9",
  "description": "Plain-English browser tests on Playwright. Write steps as sentences, keep TypeScript, and run the suite on every pull request.",
  "keywords": [
    "playwright",
    "e2e",
    "end-to-end",
    "testing",
    "browser-testing",
    "ai",
    "llm",
    "typescript",
    "test-runner",
    "plain-english"
  ],
  "license": "MIT",
  "homepage": "https://sedum.dev",
  "bugs": {
    "url": "https://github.com/sedum-dev/sedum/issues"
  },
  "repository": "https://github.com/sedum-dev/sedum",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "sedum": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sedum-dev/core": "workspace:*",
    "@sedum-dev/provider-clef": "workspace:*",
    "@sedum-dev/provider-typesafe": "workspace:*",
    "@sedum-dev/reporters": "workspace:*",
    "commander": "14.0.2",
    "minimatch": "10.2.6",
    "yaml": "2.9.1"
  }
}
