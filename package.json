{
  "name": "sedum-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:verify": "node scripts/verify-replies.mjs",
    "fixtures:record": "node scripts/record-replies.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.1",
    "@types/node": "20.19.37",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.1",
    "prettier": "3.9.8",
    "tsup": "8.5.1",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7",
    "xmllint-wasm": "5.3.0"
  }
}
