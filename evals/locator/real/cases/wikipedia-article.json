{
  "site": "wikipedia-article",
  "targets": {
    "search": "#searchInput",
    "search-button": "#searchform > button",
    "talk": "#ca-talk > a",
    "history": "#ca-history > a",
    "login": "#pt-login-2 > a",
    "babbage-first": "#mwGQ",
    "toc-work-toggle": "#toc-Work > button",
    "theme-dark": "#skin-client-pref-skin-theme-value-night",
    "languages": "#p-lang-btn-checkbox",
    "infobox-marylebone": "#mwAQ > table > tbody > tr:nth-of-type(4) > td > div > a",
    "hide-contents": "button[aria-label=\"Hide Contents\"]"
  },
  "cases": [
    {
      "id": "wp-search",
      "op": "fill",
      "sentence": "type {{query}} in the Search Wikipedia field",
      "gold": ["search"],
      "tags": ["exact-label"]
    },
    {
      "id": "wp-search-button",
      "op": "click",
      "sentence": "click the Search button",
      "gold": ["search-button"],
      "tags": ["exact-label"]
    },
    {
      "id": "wp-talk",
      "op": "click",
      "sentence": "click the Talk tab",
      "gold": ["talk"],
      "tags": ["exact-label"]
    },
    {
      "id": "wp-history",
      "op": "click",
      "sentence": "click View history",
      "gold": ["history"],
      "tags": ["exact-label"]
    },
    {
      "id": "wp-login",
      "op": "click",
      "sentence": "click Log in",
      "gold": ["login"],
      "tags": ["exact-label"]
    },
    {
      "id": "wp-babbage-first",
      "op": "click",
      "sentence": "click the first Charles Babbage link in the article",
      "gold": ["babbage-first"],
      "tags": ["ordinal", "repeated-group"]
    },
    {
      "id": "wp-edit-absent",
      "op": "click",
      "sentence": "click the Print this page button",
      "gold": "none",
      "tags": ["absent"]
    },
    {
      "id": "wp-toc-expand-work",
      "op": "click",
      "sentence": "expand the Work subsection in the table of contents",
      "gold": ["toc-work-toggle"],
      "tags": ["aria-label", "paraphrase", "region"]
    },
    {
      "id": "wp-theme-dark",
      "op": "click",
      "sentence": "select the Dark color option under Appearance",
      "gold": ["theme-dark"],
      "tags": ["radio", "region", "invisible-to-sedum"]
    },
    {
      "id": "wp-languages",
      "op": "click",
      "sentence": "click the 112 languages button",
      "gold": ["languages"],
      "tags": ["exact-label", "invisible-to-sedum"]
    },
    {
      "id": "wp-lord-byron-unscoped",
      "op": "click",
      "sentence": "click the Lord Byron link",
      "gold": "ambiguous",
      "tags": ["duplicate-name", "underspecified", "in-text-link"]
    },
    {
      "id": "wp-infobox-marylebone",
      "op": "click",
      "sentence": "click Marylebone in the infobox",
      "gold": ["infobox-marylebone"],
      "tags": ["container", "in-text-link"]
    },
    {
      "id": "wp-hide-contents",
      "op": "click",
      "sentence": "hide the Contents sidebar",
      "gold": ["hide-contents"],
      "tags": ["paraphrase", "region", "duplicate-name"]
    },
    {
      "id": "wp-hide-unscoped",
      "op": "click",
      "sentence": "click the hide button",
      "gold": "ambiguous",
      "tags": ["duplicate-name", "underspecified"]
    },
    {
      "id": "wp-pdf-absent",
      "op": "click",
      "sentence": "click the Download as PDF link",
      "gold": "none",
      "tags": ["absent"]
    }
  ]
}
