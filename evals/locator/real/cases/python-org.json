{
  "site": "python-org",
  "targets": {
    "search": "#id-search-field",
    "go": "#submit",
    "logo": "#touchnav-wrapper > header > div > div:nth-of-type(1) > a",
    "python-tab": "#top > nav > ul > li:nth-of-type(1) > a",
    "pypi-tab": "#top > nav > ul > li:nth-of-type(4) > a",
    "downloads-menu": "#downloads > a",
    "shell": "#start-shell",
