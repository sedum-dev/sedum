    {
      "id": "ap-learn-more-unscoped",
      "op": "click",
      "sentence": "click Learn more",
      "gold": "ambiguous",
      "tags": ["repeated-group", "underspecified"]
    },
    {
      "id": "ap-buy-unscoped",
      "op": "click",
      "sentence": "click the Buy link",
      "gold": "ambiguous",
      "tags": ["repeated-group", "underspecified"]
    },
    {
      "id": "ap-compare-all",
      "op": "click",
      "sentence": "click Compare all models",
      "gold": ["compare_all"],
      "tags": ["exact-label"]
    },
    {
      "id": "ap-next-chapter",
      "op": "click",
