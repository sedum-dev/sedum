    "switch_android": "#iphone-index > nav > div:nth-of-type(1) > ul > li:nth-of-type(9) > a",
    "shop_1": "a[aria-label=\"Shop iPhone\"]",
    "shop_2": "#main > section:nth-of-type(6) > div:nth-of-type(1) > header > div > ul > li > a",
