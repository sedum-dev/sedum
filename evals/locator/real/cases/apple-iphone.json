      "tags": ["nav", "exact-label", "duplicate-name"]
    },
    {
      "id": "ap-duo-learn-more",
      "op": "click",
      "sentence": "click Learn more for iPhone Duo",
      "gold": ["duo_learn_1", "duo_learn_2"],
      "tags": ["container", "repeated-group", "duplicate-name"]
    },
    {
      "id": "ap-buy-air",
      "op": "click",
      "sentence": "click Buy under iPhone Air",
      "gold": ["buy_air"],
      "tags": ["container", "repeated-group"]
